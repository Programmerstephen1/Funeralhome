# Copy to backend/.env for local development. Never commit real credentials.
APP_ENV=development
FLASK_DEBUG=False

# Optional for local development. Production migrations must target the verified
# Neon direct (non-pooled) connection for the intended branch, with SSL enabled.
# Production must never fall back to SQLite.
# DATABASE_URL=postgresql://user:password@localhost:5432/funeralhome

# For phone-on-LAN testing, replace localhost with the development computer's
# LAN IP and port 4173 in both values.
FRONTEND_URL=http://localhost:4173
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
REDIS_URL=redis://localhost:6379/0

# S3-compatible private object storage (AWS S3 or Cloudflare R2).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SSE=
OBJECT_STORAGE_URL_TTL=300

# Configure only after confirming the number of trusted ingress proxies.
# Local development connects directly and does not trust forwarded headers.
TRUSTED_PROXY_HOPS=0

# Generate different long values for stable sessions/JWT signing.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# SMTP: use an app password or provider token, not a personal account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=False

# Optional website-grounded chat provider (OpenAI-compatible Chat Completions).
# Keep this key server-side; never put it in frontend/.env or a VITE_* variable.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Sentry project DSN. Event request data, user context, and URL paths
# are scrubbed before transmission; keep this blank in local development.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Image upload limits; request bodies are capped at 10 MiB by the API.
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_PIXELS=25000000

# CSP reports only until third-party flows have been reviewed. Enable HSTS
# only after HTTPS is enforced for the host.
CSP_REPORT_ONLY=True
ENABLE_HSTS=False
FORCE_HTTPS=False

# Optional M-Pesa settings. Live checkout requires credentials, a public HTTPS
# callback URL, and a strong callback token.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# MPESA_OAUTH_URL=
# MPESA_STK_PUSH_URL=
