# Local Flask API and account email settings.
DATABASE_URL=sqlite:///database.db
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
FRONTEND_URL=http://localhost:4173

# Gmail example: enable 2-Step Verification and use an app password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=your-sending-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-sending-address@gmail.com
MAIL_SUPPRESS_SEND=False
