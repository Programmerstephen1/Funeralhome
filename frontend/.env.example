# Copy to frontend/.env.local. Vite embeds VITE_* settings in the browser.
VITE_API_URL=http://localhost:5000
VITE_SITE_URL=http://localhost:4173

# Public provider client IDs only. Never place private secrets in VITE_*.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_TWITTER_CLIENT_ID=
VITE_SENTRY_DSN=
